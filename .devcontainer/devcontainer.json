{
  "name": "sample-fastapi-app",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "overrideCommand": false,
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [
    22,
    8000
  ],
  "portsAttributes": {
    "22": {
      "label": "SSH",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "python3 --version"
}